# ==========================================================
# Real-Time AI Interview Copilot Configuration
# ==========================================================

# Deepgram API Key (Real-Time WebSocket Speech-to-Text)
# Get your free key at: https://console.deepgram.com/
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini API Key (Streaming low-latency model: gemini-1.5-flash)
# Get your key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) OpenAI API Key for fallback (e.g. gpt-4o-mini)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key
VITE_GROQ_API_KEY=your_groq_api_key_here

# AssemblyAI API Key
VITE_ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Default AI Provider: "gemini" or "groq" or "openai"
VITE_DEFAULT_AI_PROVIDER=gemini

